{
  "name": "canopy-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @canopy/web dev",
    "dev:api": "pnpm --filter @canopy/api dev",
    "build": "turbo run build",
    "test": "node --test tests/unit/*.test.js && turbo run test",
    "lint": "turbo run lint",
    "verify": "node scripts/verify-foundation.js",
    "db:migrate": "node database/migrations/migrate.js",
    "db:seed": "node database/seeds/seed.js"
  },
  "devDependencies": {
    "turbo": "^2.11.2"
  }
}
