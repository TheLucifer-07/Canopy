{
  "name": "canopy-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @canopy/web dev",
    "dev:api": "pnpm --filter @canopy/api dev",
    "build": "turbo run build",
    "test": "node --test tests/unit/*.test.js && turbo run test",
    "lint": "turbo run lint",
    "verify": "node scripts/verify-foundation.js",
    "db:migrate": "psql -v ON_ERROR_STOP=1 -f database/migrations/0000_init_pgvector.sql -f database/migrations/0001_core_platform.sql -f database/migrations/0002_atomic_version_creation.sql -f database/migrations/0003_creative_evolution.sql -f database/migrations/0004_copilot_retrieval.sql -f database/migrations/0005_machine_tokens.sql",
    "db:seed": "node database/seeds/seed.js"
  },
  "devDependencies": {
    "turbo": "^2.11.2"
  }
}
