# ==============================================================================
# CANOPY — Environment Configuration Template
# Copy to .env for local development.
# NEVER commit a real .env file with actual credentials.
# ==============================================================================

# ── Node ───────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Canopy API (server only) ───────────────────────────────────────────────────
API_PORT=
API_HOST=
API_BASE_URL=
CORS_ORIGIN=http://localhost:5173

# ── PostgreSQL / API-owned infrastructure ──────────────────────────────────────
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=canopy
PGUSER=canopy
PGPASSWORD=
PGSSL=false
AUTH_JWT_SECRET=
STORAGE_PATH=./storage/data

# ── AI Providers (server only) ────────────────────────────────────────────────
# !! SERVER ONLY — never expose these to the browser
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_VISION_MODEL=
GEMINI_EMBEDDING_MODEL=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_MODEL=
GROQ_SUMMARY_MODEL=

# ── AI Limits / Budget (future AI enforcement) ────────────────────────────────
AI_DAILY_COST_LIMIT=
AI_DAILY_TOKEN_LIMIT=

# ── Web client (public, Vite-exposed) ─────────────────────────────────────────
VITE_API_URL=http://localhost:3000/v1

# ── MCP service (server/local integration only) ───────────────────────────────
CANOPY_API_URL=http://localhost:3000/v1
CANOPY_MCP_TOKEN=
