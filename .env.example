# ==============================================================================
# CANOPY — Environment Configuration Template
# Copy to .env for local development.
# NEVER commit a real .env file with actual credentials.
# ==============================================================================

# ── Node ───────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Canopy API (server only) ───────────────────────────────────────────────────
API_PORT=
API_HOST=
API_BASE_URL=
CORS_ORIGIN=http://localhost:5173

# ── Supabase ───────────────────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# !! SERVER ONLY — never expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ── AI Providers (server only; configured for future phases, unused in Phase 1) ─
# !! SERVER ONLY — never expose these to the browser
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_VISION_MODEL=
GEMINI_EMBEDDING_MODEL=

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_REASONING_MODEL=
GROK_SUMMARY_MODEL=

# ── AI Limits / Budget (future AI enforcement) ────────────────────────────────
AI_DAILY_COST_LIMIT=
AI_DAILY_TOKEN_LIMIT=

# ── Web client (public, Vite-exposed) ─────────────────────────────────────────
# Only VITE_ prefixed vars are sent to the browser bundle
VITE_API_URL=http://localhost:3000/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
